# Gestia RRSS (Eskala Marketing Digital · https://www.eskaladigital.com/) — Variables de entorno
# Copia este archivo como .env.local y rellena los valores
# Documentación completa: README.md (actualizado agosto 2026)

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# OpenAI (estrategia, calendario, imágenes vía Responses API + gpt-image-2, referencias, reglas físicas)
# La API key debe tener permiso de generación de imágenes (gpt-image) en la organización OpenAI.
OPENAI_API_KEY=sk-tu-api-key

# Fidelidad de producto: si "true", tras generar una imagen con producto y QA
# fallido, regenera otra vez (más fiel pero DUPLICA el tiempo, ~4-5 min y riesgo
# de timeout). Por defecto desactivado: una sola pasada (~2 min) y la QA queda
# como información en la respuesta.
IMAGE_FIDELITY_AUTO_RETRY=false

# Google AI — animación Veo (POST /api/generate-image no la usa; solo /api/generate-video)
# Alternativa: clave en Ajustes → Proveedores IA (tabla provider_api_keys)
GOOGLE_AI_API_KEY=

# Scraping (opcional - para cuando integres Firecrawl/Apify)
FIRECRAWL_API_KEY=
# Refuerzo: si fetch falla o el texto es muy pobre, se usa Website Content Crawler
APIFY_API_TOKEN=
# Opcional; por defecto apify/website-content-crawler
# APIFY_WEB_CRAWLER_ACTOR_ID=apify/website-content-crawler
# Búsqueda Google orgánica (competidores + contexto en «Analizar web»)
# APIFY_GOOGLE_SEARCH_ACTOR_ID=apify/google-search-scraper
# SearchAPI.io — https://www.searchapi.io/docs/google
SEARCHAPI_API_KEY=
# SerpAPI.com — https://serpapi.com/search-api (mismo uso en código que SearchAPI.io)
SERPAPI_KEY=
# Opcional SearchAPI.io base
# SEARCHAPI_BASE_URL=
# No uses NEXT_PUBLIC_* para claves de SERP (se expondrían al navegador)
# Quién va primero: auto (Apify SERP y si falla/vacío → SearchAPI) | apify_only | searchapi_only
# SERP_PROVIDER=auto

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Scripts locales (ver README § Scripts de mantenimiento)
# references:reanalyze | references:sync-rules → SUPABASE_SERVICE_ROLE_KEY + OPENAI_API_KEY
# images:regenerate-project → además NEXT_PUBLIC_APP_URL si el script llama a la API local
# images:import-project-references → carpeta local de JPG/PNG + mismo Supabase/OpenAI
# En Windows con UNABLE_TO_VERIFY_LEAF_SIGNATURE hacia Supabase, usa npm run references:* (preload TLS).
